<?xml version="1.0" encoding="utf-8"?>
<!--
  HTTPS only. Certificate authorities the device owner installed are trusted
  as well as the system ones, so servers with certificates from a private CA
  work without pinning.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
